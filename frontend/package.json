{
  "name": "sheetproof-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-go-boundary.mjs",
    "dev": "vite",
    "lint": "eslint src --max-warnings=0",
